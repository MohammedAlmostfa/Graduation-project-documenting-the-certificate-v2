# Application configuration
PORT=3000
ENCRYPTION_KEY=your_super_secret_encryption_key_here
JWT_SECRET=your_jwt_secret_here
DEFAULT_USER_PASSWORD=University@2026

# MySQL database configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name

# Logging level: error, warn, info, verbose, debug, silly
LOG_LEVEL=debug
LOG_LEVEL_FILE=info

# Telegram Configuration (Optional - for notifications and error alerts)
# Get your bot token from BotFather: https://t.me/BotFather
# Get your chat ID: https://t.me/userinfobot or check with @username
# Leave empty to disable Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
